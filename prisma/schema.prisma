generator client {
  provider   = "prisma-client"
  output     = "../generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum PricingMode {
  PUBLIC_PRICE
  STARTING_AT
  REQUEST_QUOTE
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  ON_REQUEST
}

enum QuoteRequestStatus {
  NEW
  REVIEWING
  CONTACTED
  QUOTED
  WON
  LOST
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String             @id @default(cuid())
  categoryId  String?
  category    Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  slug        String             @unique
  sku         String             @unique
  summary     String
  description String?
  isActive    Boolean            @default(true)
  isFeatured  Boolean            @default(false)
  pricingMode PricingMode        @default(REQUEST_QUOTE)
  currency    String             @default("USD")
  prices      ProductPrice[]
  inventory   InventoryItem?
  quoteItems  QuoteRequestItem[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([categoryId, isActive])
  @@index([isFeatured, isActive])
}

model ProductPrice {
  id            String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  amount         Decimal? @db.Decimal(10, 2)
  label          String?
  isActive       Boolean  @default(true)
  effectiveFrom  DateTime @default(now())
  expiresAt      DateTime?
  createdAt      DateTime @default(now())

  @@index([productId, isActive, effectiveFrom(sort: Desc)])
}

model InventoryItem {
  id                String      @id @default(cuid())
  productId         String      @unique
  product           Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityAvailable Int         @default(0)
  reorderLevel      Int?
  stockStatus       StockStatus @default(ON_REQUEST)
  leadTimeDays      Int?
  notes             String?
  lastCheckedAt     DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model QuoteRequest {
  id                     String             @id @default(cuid())
  fullName               String
  company                String?
  email                  String
  phone                  String?
  message                String
  projectType            String?
  industry               String?
  location               String?
  timeline               String?
  budget                 String?
  primaryService         String?
  preferredContactMethod String?
  sourcePage             String?
  status                 QuoteRequestStatus @default(NEW)
  submittedAt            DateTime           @default(now())
  items                  QuoteRequestItem[]

  @@index([status, submittedAt(sort: Desc)])
  @@index([email])
}

model QuoteRequestItem {
  id                  String       @id @default(cuid())
  quoteRequestId      String
  productId           String?
  productNameSnapshot String
  skuSnapshot         String?
  quantity            Int          @default(1)
  notes               String?
  quoteRequest        QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  product             Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt           DateTime     @default(now())

  @@index([quoteRequestId])
  @@index([productId])
}
